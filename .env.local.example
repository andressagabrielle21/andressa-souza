# Variáveis de ambiente — copie este arquivo para .env.local e preencha os valores
# NUNCA comite o .env.local no git (ele já está no .gitignore do Next.js por padrão)

# Token de acesso pessoal do GitHub (aumenta o rate limit de 60 para 5.000 req/hora)
# Como criar: https://github.com/settings/tokens
# Tipo recomendado: "Fine-grained token" ou "Classic token" sem escopos adicionais
# (repositórios públicos não precisam de escopos)
GITHUB_TOKEN=ghp_seu_token_aqui
